{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bruinformula/mk12-vcu/profiles/schema.json",
  "title": "MK12 VCU driver profile",
  "description": "Generated by tools/gen_profile.py schema. Do not edit. base.yaml sets every key; other profiles set `extends: base` and override a subset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,30}$"
    },
    "extends": {
      "const": "base"
    },
    "torque": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_nm": {
          "type": "integer",
          "minimum": 20,
          "maximum": 150,
          "description": "MAX_TORQUE"
        },
        "pedal_table": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "torqueMap_table: fraction of max_nm from drive_start to full pedal. Starts at 0, ends at 1, never decreases."
        }
      }
    },
    "pedal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coast_end": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.1,
          "description": "REGEN_END_PERCENT"
        },
        "drive_start": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.2,
          "description": "APPS_INFLECTION_PERCENT"
        }
      }
    },
    "regen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liftoff_nm": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "description": "REGEN_LIFTOFF_TORQUE"
        },
        "fade_lo_kph": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "REGEN_FADE_LO_KPH"
        },
        "fade_hi_kph": {
          "type": "number",
          "minimum": 5,
          "maximum": 60,
          "description": "REGEN_FADE_HI_KPH"
        },
        "ramp_nm_s": {
          "type": "number",
          "minimum": 5,
          "maximum": 200,
          "description": "REGEN_RAMP_NM_S"
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tau_s": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.2,
          "description": "RC_TIME_CONSTANT"
        },
        "slew_nm_s": {
          "type": "number",
          "minimum": 200,
          "maximum": 10000,
          "description": "SLEW_RATE_LIMIT"
        }
      }
    }
  }
}
